# SubscriptionEngine - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# ---------------------------------------------------------------------------
# Database
# SQLite (local development):
DATABASE_URL=sqlite:///./subscription_dev.db
# MySQL (production, driver already installed):
# DATABASE_URL=mysql+pymysql://username:password@localhost:3306/subscription_db
# NOTE: the installed dependency set ships pymysql (MySQL driver). For
# PostgreSQL, swap `pymysql` for `psycopg2-binary` in requirements.txt.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# JWT / Authentication
# Generate a strong secret for production, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-secret
JWT_ALGORITHM=HS256

# Access-token lifetime in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30
# ---------------------------------------------------------------------------
